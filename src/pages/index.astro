---
import '../styles/global.css';
import { homenagem as h } from '../conteudo';
import Ceu from '../components/Ceu.astro';
import Abertura from '../components/Abertura.astro';
import Momento from '../components/Momento.astro';
import CartaFinal from '../components/CartaFinal.astro';
import Navegacao from '../components/Navegacao.astro';

/* Numeração dos espaços de foto (a foto 01 é a da abertura). */
let proxima = 2;
const inicios = h.momentos.map((m) => {
  const inicio = proxima;
  proxima += m.fotos.length;
  return inicio;
});
---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#140726" />
    <title>{h.tituloDaAba}</title>
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,400;0,500;0,600;1,400&family=Gloock&family=Nothing+You+Could+Do&display=swap"
    />
  </head>
  <body>
    <Ceu />

    <main class="rolagem">
      <div class="palco" id="palco">
        <div class="trilha" id="trilha">
          <svg class="fio" id="fio" aria-hidden="true"></svg>

          <Abertura h={h} />

          {h.momentos.map((m, i) => (
            <Momento m={m} indice={i} total={h.momentos.length} lado={i % 2 === 0 ? 'pendurado' : 'apoiado'} primeiraFoto={inicios[i]} />
          ))}

          <CartaFinal final={h.final} />

          <section class="estacao apoiado fim" data-rotulo="Fim" aria-label="Fim">
            <div class="conteudo">
              <p class="encerramento">{h.encerramento}</p>
            </div>
          </section>
        </div>

        <Navegacao />
      </div>
    </main>

    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
