---
/*
 * Céu roxo com luzes desfocadas (bokeh).
 * As luzes são geradas uma vez no build e ficam em 3 camadas de profundidade.
 * Na rolagem, cada camada só é deslocada (transform), o que roda direto na placa de vídeo.
 */
function semente(s: number) {
  return () => {
    s = (s + 0x6d2b79f5) | 0;
    let t = Math.imul(s ^ (s >>> 15), 1 | s);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const tons = ['214,190,255', '255,138,214', '160,110,255', '255,210,140', '128,150,255', '234,120,255', '255,176,226', '190,140,255'];

const camadas = [
  { prof: 0.06, qtd: 26, min: 70, max: 170, alfa: [0.08, 0.18] },
  { prof: 0.16, qtd: 30, min: 36, max: 110, alfa: [0.14, 0.3] },
  { prof: 0.3, qtd: 18, min: 20, max: 64, alfa: [0.22, 0.42] },
].map((c, ci) => {
  const r = semente(41 + ci * 7);
  const luzes = Array.from({ length: c.qtd }, () => {
    const tam = c.min + r() * (c.max - c.min);
    return {
      x: (r() * 100).toFixed(2),
      y: (r() * 100).toFixed(2),
      tam: tam.toFixed(0),
      cor: tons[Math.floor(r() * tons.length)],
      alfa: (c.alfa[0] + r() * (c.alfa[1] - c.alfa[0])).toFixed(3),
      disco: r() < 0.45,
      anima: r() < 0.55,
      dur: (5 + r() * 7).toFixed(1),
      atraso: (-r() * 10).toFixed(1),
      sobe: ((r() - 0.5) * 36).toFixed(0),
    };
  });
  return { ...c, luzes };
});
---

<div class="ceu" aria-hidden="true">
  {camadas.map((c) => (
    <div class="camada" data-prof={c.prof}>
      {c.luzes.map((l) => (
        <i
          class={`luz${l.disco ? ' disco' : ''}${l.anima ? ' viva' : ''}`}
          style={`left:${l.x}%;top:${l.y}%;--t:${l.tam}px;--c:${l.cor};--a:${l.alfa};--dur:${l.dur}s;--atraso:${l.atraso}s;--sobe:${l.sobe}px`}
        ></i>
      ))}
    </div>
  ))}
</div>
